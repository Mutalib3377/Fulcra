# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Variables marked "later" are not used yet; they are listed so nothing is forgotten.

# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development

# Root domain the web app is served on. Locally `localhost:3000`
# (dashboard: app.localhost:3000, stores: <name>.localhost:3000).
# In production, the real domain (placeholder: yourdomain.com).
ROOT_DOMAIN=localhost:3000

# ─── Database (Postgres) ────────────────────────────────────────────────────
# Connection used by the web app and worker. Local: Supabase CLI, started with `pnpm db:up`.
# Production: Supabase pooled connection string (transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Connection used only by `pnpm db:migrate` (database owner). Optional locally;
# defaults to DATABASE_URL. Production: Supabase direct connection (port 5432).
DATABASE_URL_MIGRATIONS=

# Separate database for automated tests (created and migrated automatically by the tests).
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:54322/fulcra_test

# ─── Supabase Auth (C1) ─────────────────────────────────────────────────────
# Local values below are the Supabase CLI's fixed defaults (same on every machine,
# not secret). Check them with `pnpm db:status`. Production: Supabase dashboard → API keys.
# Server-only: login runs in server actions, so these are read at runtime, not baked into the build.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Sign-in code emails sent locally appear in the test inbox: http://127.0.0.1:54324

# ─── Encryption (later: A1) ─────────────────────────────────────────────────
# 32-byte key (base64) for encrypting channel tokens and catalog credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── File storage (C2) ──────────────────────────────────────────────────────
# Product photos and logos. Any S3-compatible storage.
# Local: Supabase Storage from `pnpm db:up` (values below are the Supabase CLI's fixed
#   local defaults, not secret; check with `pnpm db:status`).
# Production: Cloudflare R2. STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#   STORAGE_REGION=auto, an R2 API token's key pair, and STORAGE_PUBLIC_URL = the bucket's
#   public URL (custom domain such as https://media.yourdomain.com).
STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_REGION=local
STORAGE_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
STORAGE_SECRET_ACCESS_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
STORAGE_BUCKET=fulcra-media
STORAGE_PUBLIC_URL=http://127.0.0.1:54321/storage/v1/object/public/fulcra-media

# ─── Paystack (P1) ──────────────────────────────────────────────────────────
# Secret key from Paystack dashboard → Settings → API Keys & Webhooks. Use the TEST key
# (sk_test_...) in development. Server-only. Also used to check webhook signatures.
PAYSTACK_SECRET_KEY=
# Optional: only for pointing at a fake Paystack in local tests.
# PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook URL to set in the Paystack dashboard: https://app.yourdomain.com/api/webhooks/paystack
# Locally, expose the dev server with Cloudflare Tunnel (cloudflared tunnel --url http://localhost:3000)
# and use <tunnel-url>/api/webhooks/paystack. Run `pnpm dev` so the worker processes payments.

# ─── Meta: WhatsApp Cloud API + Instagram (later: A3, G1) ───────────────────
META_APP_ID=
META_APP_SECRET=
# Token you choose; Meta sends it back when verifying the webhook URL.
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── Anthropic / Claude API (later: A2) ─────────────────────────────────────
# Set a monthly spending limit on this key in the Anthropic console.
ANTHROPIC_API_KEY=

# ─── Catalog import (later: I1) ─────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ─── Monitoring (later: L1) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
