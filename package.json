{
  "name": "fulcra",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "supabase start && supabase seed buckets --local",
    "db:down": "supabase stop",
    "db:generate": "pnpm --filter @fulcra/db db:generate",
    "db:migrate": "pnpm --filter @fulcra/db db:migrate",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && pnpm db:migrate",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "prepare": "node -e \"try{require('child_process').execSync('git rev-parse --is-inside-work-tree && git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
