{
  "name": "@fulcra/widget",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable website chat widget. Builds to one small async script.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=../../apps/web/public/widget.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --target=es2019 --watch=forever --outfile=../../apps/web/public/widget.js"
  },
  "dependencies": {
    "@fulcra/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.12",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
