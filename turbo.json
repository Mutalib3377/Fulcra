{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_MIGRATIONS",
    "DATABASE_URL_TEST",
    "ROOT_DOMAIN",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "STORAGE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    }
  }
}
